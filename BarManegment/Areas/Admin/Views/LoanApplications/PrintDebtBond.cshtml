@model BarManegment.Models.LoanApplication
@{
    Layout = null;
    ViewBag.Title = "طباعة سند إقرار ومديونية";
    string amountInWords = ViewBag.AmountInWords ?? "خطأ في التفقيط";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - @Model.Lawyer.ArabicName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap');

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #555;
            margin: 0;
            padding: 20px;
        }

        .a4-page {
            width: 210mm;
            min-height: 297mm;
            background: white;
            margin: 0 auto;
            padding: 20mm;
            box-sizing: border-box;
            box-shadow: 0 0 15px rgba(0,0,0,0.5);
            position: relative;
        }

            .a4-page::before {
                content: "PALESTINE";
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%) rotate(-45deg);
                font-size: 100pt;
                font-weight: bold;
                color: rgba(220, 220, 220, 0.15);
                z-index: 0;
                pointer-events: none;
            }

        .content-layer {
            position: relative;
            z-index: 1;
        }

        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 3px solid #b71c1c;
            padding-bottom: 10px;
            margin-bottom: 25px;
        }

        /* تصغير خطوط الترويسة */
        .header-info h2 {
            font-size: 18px;
            font-weight: 800;
            margin: 0;
            color: #000;
        }

        .header-info p {
            font-size: 12px;
            font-weight: 600;
            margin: 0;
            color: #555;
            letter-spacing: 1px;
        }

        .logo-img {
            max-height: 80px;
            width: auto;
        }

        .loan-ref-box {
            border: 2px solid #000;
            padding: 5px 10px;
            font-weight: bold;
            font-size: 12px;
            border-radius: 4px;
        }

        /* تصغير العنوان الرئيسي */
        .main-title {
            text-align: center;
            font-size: 20pt; /* كان 24 */
            font-weight: 800;
            margin-bottom: 30px;
            text-decoration: underline;
        }

        /* تصغير خط المحتوى */
        .bond-body {
            font-size: 13pt; /* كان 14 */
            line-height: 2.0; /* كان 2.2 */
            text-align: justify;
        }

        .form-field {
            font-weight: bold;
            text-decoration: underline;
            padding: 0 5px;
        }

        /* تصغير خط التواقيع */
        .signature-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px 10px;
            margin-top: 40px;
            text-align: center;
            font-size: 10pt; /* كان 11 */
            font-weight: bold;
        }

        .sig-box {
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            min-height: 60px;
        }

        .sig-line {
            border-bottom: 1px dotted #000;
            margin-bottom: 5px;
            height: 35px;
        }

        .no-print {
            text-align: center;
            margin-bottom: 20px;
        }

        @@media print {
            @@page {
                size: A4;
                margin: 0;
            }

            body {
                background: none;
                margin: 0;
                padding: 0;
            }

            .a4-page {
                width: 100%;
                height: auto;
                box-shadow: none;
                margin: 0;
                padding: 15mm;
                border: none;
            }

            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="no-print">
        <div class="bg-white p-3 rounded shadow d-inline-block mt-3">
            <button onclick="window.print()" class="btn btn-primary fw-bold px-4"><i class="bi bi-printer-fill me-2"></i> طباعة السند</button>
            <button onclick="window.close()" class="btn btn-secondary px-4 ms-2">إغلاق</button>
        </div>
    </div>

    <div class="a4-page">
        <div class="content-layer">
            <div class="header-section">
                <div class="header-info d-flex align-items-center">
                    <img src="@Url.Content("~/Content/Images/logo.png")" class="logo-img ms-3" alt="Logo" />
                    <div>
                        <h2>نقابة المحامين الفلسطينيين</h2>
                        <p>PALESTINIAN BAR ASSOCIATION</p>
                    </div>
                </div>
                <div class="loan-ref-box">رقم القرض: @Model.Id</div>
            </div>

            <div class="main-title">سند إقرار ومديونية</div>

            <div class="bond-body">
                <p>
                    نعم أنا الموقع أدناه المحامي/ة: <span class="form-field">@Model.Lawyer.ArabicName</span>،
                    أحمل هوية رقم: <span class="form-field">@Model.Lawyer.User.IdentificationNumber</span>.
                </p>

                <p>
                    أقر بأنني استفدت من برنامج القرض الحسن بنقابة المحامين وذلك بمبلغ وقدره
                    <span class="form-field">@Model.Amount.ToString("N2") @(Model.LoanType.BankAccount?.Currency?.Name ?? "")</span>
                    (<span class="form-field">@amountInWords</span>)،
                    على أن أقوم بسداد هذا المبلغ على دفعات شهرية محرر بها كمبيالات، وفي حال تخلفي عن سداد أي دفعة في موعدها المحدد تعتبر جميع الدفعات مستحقة الأداء فوراً.
                </p>
                <p>
                    وترجو نقابة المحامين تنفيذ جميع الكمبيالات أو الكمبيالة الإجمالية وفقاً للأصول القانونية. كما وأنني أقر بأنه يعمل بهذا السند أمام دوائر التنفيذ ولا يحق لي أن أعترض على التنفيذ وأسقط حقي بالاعتراض مستقبلاً.
                </p>

                <div class="signature-grid">
                    <div class="sig-box">المقر بما فيه <div class="sig-line"></div></div>
                    <div class="sig-box">الكفيل الأول <div class="sig-line"></div></div>
                    <div class="sig-box">الكفيل الثاني <div class="sig-line"></div></div>
                    <div class="sig-box">الموظف المختص <div class="sig-line"></div></div>
                </div>

                <hr style="border-top: 2px dashed #999; margin: 30px 0;" />

                <h4 style="text-decoration: underline; font-weight: bold; margin-bottom: 15px; font-size: 16px;">تفويض</h4>
                <p>
                    كما وأنني والكفلاء من الأساتذة المحامين وبموجب توقيعنا على هذا السند، فإننا نفوض نقابة المحامين بالتصرف بأي مبالغ مستحقة لنا أو قد تستحق نظير أي عمل أو حقوق لنا بموجب أنظمة النقابة، تصرفاً لسداد قيمة أي قسط أو قيمة القرض بالكامل حتى سداده، وهذا حال عدم التزامنا بسداد أي قسط من الأقساط في موعده.
                </p>

                <div class="signature-grid">
                    <div class="sig-box">المفوض (المقترض) <div class="sig-line"></div></div>
                    <div class="sig-box">الكفيل الأول <div class="sig-line"></div></div>
                    <div class="sig-box">الكفيل الثاني <div class="sig-line"></div></div>
                    <div class="sig-box">شاهد / موظف <div class="sig-line"></div></div>
                </div>
            </div>
        </div>
    </div>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</body>
</html>