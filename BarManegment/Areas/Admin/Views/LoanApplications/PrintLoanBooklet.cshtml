@model BarManegment.Models.LoanApplication
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>دفتر أقساط القرض - @Model.Lawyer.ArabicName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap');

        body {
            font-family: 'Cairo', sans-serif;
            background: #eee;
            margin: 0;
        }

        .booklet-page {
            width: 210mm;
            /* استخدام min-height قد يسبب مشاكل في الطباعة، نستخدم height ثابت للصفحة */
            height: 296mm;
            background: white;
            margin: 0 auto;
            padding: 10mm 10mm 0 10mm; /* إزالة البادينج السفلي */
            box-sizing: border-box;
            overflow: hidden; /* لمنع أي محتوى زائد من إنشاء صفحة جديدة */
            page-break-after: always;
        }

        /* إلغاء الفاصل للصفحة الأخيرة لتجنب صفحة فارغة في النهاية */
        .booklet-page:last-of-type {
            page-break-after: auto;
        }

        .voucher-slip {
            border: 2px solid #000;
            border-radius: 8px;
            padding: 10px 15px; /* تقليل البادينج الداخلي */
            margin-bottom: 0; /* إزالة المارجن السفلي */
            position: relative;
            background: #fff;
            height: 88mm; /* تقليل الارتفاع ليتناسب تماماً (88*3 = 264 + هوامش) */
            box-sizing: border-box;
        }

        .cut-line {
            border-bottom: 1px dashed #999;
            margin: 3mm 0; /* تقليل هوامش القص */
            position: relative;
            text-align: center;
            height: 1px;
        }

        .cut-line::after {
            content: '✂ قص من هنا';
            background: #fff;
            padding: 0 10px;
            font-size: 9px;
            color: #777;
            position: relative;
            top: -8px;
        }

        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 5px;
            margin-bottom: 8px;
        }

        /* تحسينات الخطوط والمسافات لضغط المحتوى */
        h5 { font-size: 16px; margin-bottom: 2px; }
        small { font-size: 11px; }
        .kv-box { margin-bottom: 3px; font-size: 13px; }

        .bank-info-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            padding: 6px;
            border-radius: 4px;
            font-size: 11px;
            text-align: right;
            width: 100%;
            margin-top: 8px;
        }

        .kv-label { font-weight: bold; color: #555; min-width: 100px; }
        .kv-value { font-weight: bold; color: #000; }

        .amount-box {
            background: #e3f2fd;
            color: #0d47a1;
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: 800;
            font-size: 15px;
            display: inline-block;
            min-width: 90px;
        }

        .latin-num {
            font-family: 'Courier New', monospace;
            direction: ltr;
            unicode-bidi: embed;
            font-weight: bold;
        }

        @@media print {
            @@page { margin: 0; size: A4; } /* إزالة هوامش المتصفح الافتراضية */
            body { background: none; margin: 0; padding: 0; }
            .booklet-page { width: 100%; height: 296mm; padding: 10mm 5mm 0 5mm; margin: 0; box-shadow: none; page-break-after: always; }
            .booklet-page:last-of-type { page-break-after: auto; }
            .no-print { display: none !important; }
            .voucher-slip { border: 1px solid #000; }
        }
    </style>
</head>
<body>

    <div class="text-center my-4 no-print">
        <button onclick="window.print()" class="btn btn-primary btn-lg fw-bold shadow"><i class="bi bi-printer"></i> طباعة دفتر الأقساط</button>
        <button onclick="window.close()" class="btn btn-secondary btn-lg ms-2">إغلاق</button>
    </div>

    @{
        var installments = Model.Installments.OrderBy(i => i.InstallmentNumber).ToList();
        int total = installments.Count;
        int pageSize = 3;
        int pagesCount = (int)Math.Ceiling((double)total / pageSize);
    }

    @for (int p = 0; p < pagesCount; p++)
    {
        var pageItems = installments.Skip(p * pageSize).Take(pageSize).ToList();

        <div class="booklet-page">
            @for (int i = 0; i < pageItems.Count; i++)
            {
                var installment = pageItems[i];

                <div class="voucher-slip">
                    <div class="header-row">
                        <div>
                            <h5 class="m-0 fw-bold">نقابة المحامين الفلسطينيين</h5>
                            <small class="text-muted">إيصال إيداع قسط قرض (نسخة البنك / المحامي)</small>
                        </div>
                        <div class="text-end">
                            <div class="badge bg-dark text-white p-2 px-3" style="font-size: 13px;">قسط رقم @installment.InstallmentNumber</div>
                        </div>
                    </div>

                    <div class="row align-items-center">
                        <div class="col-8">
                            <div class="kv-box">
                                <span class="kv-label">اسم المحامي:</span>
                                <span class="kv-value">@Model.Lawyer.ArabicName</span>
                            </div>
                            <div class="kv-box">
                                <span class="kv-label">رقم القرض:</span>
                                <span class="kv-value">@Model.Id</span>
                            </div>
                            <div class="kv-box">
                                <span class="kv-label">تاريخ الاستحقاق:</span>
                                <span class="kv-value text-danger latin-num">@installment.DueDate.ToString("yyyy/MM/dd")</span>
                            </div>
                            <div class="kv-box">
                                <span class="kv-label">رقم المرجع:</span>
                                <span class="kv-value latin-num bg-light px-2 border rounded">@installment.PaymentVoucherId</span>
                            </div>
                        </div>
                        <div class="col-4 text-center border-start">
                            <label class="d-block text-muted small mb-1 fw-bold">المبلغ المطلوب</label>
                            <div class="amount-box">@installment.Amount.ToString("N0")</div>
                            <div class="small mt-1 fw-bold">شيكل جديد</div>
                        </div>
                    </div>

                    <div class="bank-info-box">
                        <div class="row align-items-center">
                            <div class="col-3 fw-bold text-primary text-end" style="font-size: 11px;">
                                <i class="bi bi-bank me-1"></i> @ViewBag.BankName
                            </div>
                            <div class="col-9">
                                <div class="d-flex justify-content-end gap-3">
                                    <div>
                                        <span class="text-muted small ms-1">حساب:</span>
                                        <span class="latin-num text-dark">@ViewBag.AccountNumber</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(ViewBag.IBAN) && ViewBag.IBAN != "---")
                                    {
                                        <div class="border-start ps-3">
                                            <span class="text-muted small ms-1">IBAN:</span>
                                            <span class="latin-num text-dark" style="font-size: 10px;">@ViewBag.IBAN</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-1 text-muted fst-italic" style="font-size: 10px;">
                        * يرجى تسليم هذه القسيمة لموظف البنك لضمان ترحيل الدفعة.
                    </div>
                </div>

                @* إضافة خط قص فقط إذا لم يكن العنصر الأخير في الصفحة *@
                if (i < pageItems.Count - 1)
                {
                    <div class="cut-line"></div>
                }
            }
        </div>
    }

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</body>
</html>