@model IEnumerable<BarManegment.Models.LoanInstallment>
@{
    var lawyer = (BarManegment.Models.GraduateApplication)ViewBag.Lawyer;
    ViewBag.Title = "السجل المالي للقروض - " + lawyer.ArabicName;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="text-primary fw-bold mb-1">@ViewBag.Title</h2>
        <p class="text-muted mb-0">
            رقم العضوية: <span class="font-monospace text-dark">@lawyer.MembershipId</span>
        </p>
    </div>
    @Html.ActionLink("العودة للبحث", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
<hr />

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.SuccessMessage

        @if (TempData["PrintReceiptUrl"] != null)
        {
            <a href="@TempData["PrintReceiptUrl"]" target="_blank" class="btn btn-light btn-sm float-end fw-bold border">
                <i class="bi bi-printer-fill me-1"></i> طباعة الإيصال
            </a>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>نوع القرض</th>
                        <th>رقم القسط</th>
                        <th>تاريخ الاستحقاق</th>
                        <th>المبلغ</th>
                        <th>رقم القسيمة</th>
                        <th>الحالة</th>
                        <th class="text-center" style="min-width: 250px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted p-5">
                                <i class="bi bi-folder2-open display-4 d-block mb-3 opacity-25"></i>
                                لا يوجد سجلات أقساط لهذا المحامي.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            // تحديد التنسيق بناءً على الحالة
                            string rowClass = item.IsPaid ? "bg-success bg-opacity-10" : (item.DueDate < DateTime.Now ? "bg-danger bg-opacity-10" : "");

                            <tr class="@rowClass">
                                <td class="fw-bold">@item.LoanApplication.LoanType.Name</td>
                                <td><span class="badge bg-secondary rounded-pill">@item.InstallmentNumber</span></td>

                                <td>
                                    @if (!item.IsPaid && item.DueDate < DateTime.Now)
                                    {
                                        <span class="text-danger fw-bold"><i class="bi bi-exclamation-circle"></i> @item.DueDate.ToString("yyyy-MM-dd")</span>
                                    }
                                    else
                                    {
                                        <span>@item.DueDate.ToString("yyyy-MM-dd")</span>
                                    }
                                </td>

                                <td class="fw-bold">@item.Amount.ToString("N2")</td>
                                <td class="font-monospace">@(item.PaymentVoucherId?.ToString() ?? "-")</td>

                                <td>
                                    @if (item.IsPaid)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i> مسدد</span>
                                        if (item.Receipt != null)
                                        {
                                            <div class="small text-muted mt-1">إيصال #@item.Receipt.SequenceNumber</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">مستحق للدفع</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        @if (item.IsPaid)
                                        {
                                            @* ✅ حالة السداد: طباعة الإيصال فقط *@
                                            if (item.ReceiptId.HasValue)
                                            {
                                                <a href="@Url.Action("PrintLoanInstallmentReceipt", new { id = item.ReceiptId })" target="_blank" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-printer-fill me-1"></i> طباعة الإيصال
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            @* 🛑 حالة غير مسدد: طباعة القسيمة + زر الدفع *@

                                            // 1. زر طباعة القسيمة (إذا كانت موجودة)
                                            if (item.PaymentVoucherId.HasValue)
                                            {
                                                // نوجه لطباعة القسيمة في كنترولر القسائم
                                                <a href="@Url.Action("PrintVoucher", "PaymentVouchers", new { id = item.PaymentVoucherId, area = "Admin" })" target="_blank" class="btn btn-sm btn-outline-primary" title="طباعة القسيمة للبنك">
                                                    <i class="bi bi-file-earmark-pdf"></i> قسيمة
                                                </a>
                                            }

                                            // 2. زر تسجيل السداد
                                            <a href="@Url.Action("CreateReceipt", new { id = item.Id })" class="btn btn-sm btn-success fw-bold">
                                                <i class="bi bi-cash-coin me-1"></i> دفع
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>