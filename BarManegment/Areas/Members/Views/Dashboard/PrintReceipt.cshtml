@model BarManegment.Areas.Admin.ViewModels.PrintVoucherViewModel

@{
    Layout = null;
    string amountText = ViewBag.AmountInWords as string;

    // تحديد نوع المستند: إذا كان هناك تفاصيل بنكية فهو "قسيمة إيداع"، وإلا فهو "سند قبض"
    bool isVoucherForPayment = Model.Details.Any(d => !string.IsNullOrEmpty(d.BankName));
    string docTitle = isVoucherForPayment ? "أمر توريد / قسيمة إيداع" : "سند قبض";
    string dateLabel = isVoucherForPayment ? "تاريخ الإصدار" : "تاريخ السداد";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@docTitle - @Model.VoucherId</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap');
        body { font-family: 'Cairo', sans-serif; background-color: #525659; margin: 0; padding: 20px; }
        .page-container { background: white; width: 210mm; min-height: 297mm; height: auto; margin: 0 auto; padding: 10mm; box-shadow: 0 0 10px rgba(0,0,0,0.5); }
        .voucher-half { min-height: 130mm; height: auto; border: 2px solid #333; border-radius: 8px; padding: 15px; margin-bottom: 8mm; display: flex; flex-direction: column; background-color: white; page-break-inside: avoid; }
        .voucher-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 10px; }
        .header-center h2 { font-size: 20px; font-weight: 800; margin: 0; color: #2c3e50; }
        .header-center h4 { font-size: 16px; margin: 5px 0 0; font-weight: 600; background-color: #eee; padding: 2px 10px; border-radius: 5px; display: inline-block; }
        .voucher-number { font-size: 14px; font-weight: bold; color: #dc3545; border: 1px solid #dc3545; padding: 3px 8px; border-radius: 4px; }
        .info-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; font-size: 13px; background: #fcfcfc; padding: 10px; border: 1px dashed #ccc; border-radius: 5px; }
        .info-item { flex: 1 1 45%; display: flex; align-items: baseline; }
        .info-label { font-weight: 700; min-width: 90px; color: #555; }
        .info-value { font-weight: 600; border-bottom: 1px dotted #999; flex-grow: 1; }
        .details-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 15px; flex-grow: 1; }
        .details-table th { background-color: #f8f9fa; border: 1px solid #dee2e6; padding: 6px; text-align: center; }
        .details-table td { border: 1px solid #dee2e6; padding: 6px; vertical-align: middle; }
        .total-row td { background-color: #e9ecef; font-weight: bold; font-size: 14px; }
        .amount-words { background-color: #fff3cd; border: 1px solid #ffeeba; padding: 5px 10px; font-size: 12px; font-weight: bold; text-align: center; margin-bottom: 10px; }
        .cut-line { border-top: 2px dashed #999; width: 100%; margin: 15px 0; position: relative; height: 1px; }
        .cut-icon { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: white; padding: 0 10px; font-size: 12px; color: #777; }
        @@media print { body { background: none; padding: 0; margin: 0; } .page-container { box-shadow: none; width: 100%; margin: 0; padding: 5mm; } .no-print { display: none !important; } }
    </style>
</head>
<body>
    <div class="text-center mb-4 no-print">
        <button onclick="window.print()" class="btn btn-primary btn-lg shadow fw-bold">طباعة</button>
        <button onclick="window.close()" class="btn btn-secondary btn-lg ms-2">إغلاق</button>
    </div>

    <div class="page-container">
        @RenderVoucher(docTitle, "نسخة البنك / المالية", Model, amountText, dateLabel, isVoucherForPayment)
        <div class="cut-line no-print"><span class="cut-icon">قص من هنا</span></div>
        @RenderVoucher(docTitle, "نسخة المحامي", Model, amountText, dateLabel, isVoucherForPayment)
    </div>

    @helper RenderVoucher(string title, string copyType, BarManegment.Areas.Admin.ViewModels.PrintVoucherViewModel vm, string amountText, string dateLabel, bool isVoucher)
    {
        <div class="voucher-half">
            <div class="voucher-header">
                <div class="header-right"><img src="/Content/Images/logo.png" style="height: 60px;" onerror="this.style.display='none'"></div>
                <div class="header-center">
                    <h2>نقابة المحامين الفلسطينيين</h2>
                    <h4>@title</h4>
                </div>
                <div class="header-left">
                    <div class="voucher-number">رقم: @vm.VoucherId</div>
                    <div style="font-size: 11px;">@copyType</div>
                </div>
            </div>

            <div class="info-grid">
                <div class="info-item"><span class="info-label">الاسم:</span><span class="info-value">@vm.TraineeName</span></div>
                <div class="info-item"><span class="info-label">@dateLabel:</span><span class="info-value">@vm.IssueDate.ToString("yyyy/MM/dd")</span></div>
                @if (isVoucher)
                {
                    <div class="info-item"><span class="info-label">صالح لغاية:</span><span class="info-value text-danger">@vm.ExpiryDate.ToString("yyyy/MM/dd")</span></div>
                }
                <div class="info-item"><span class="info-label">المصدر:</span><span class="info-value">@vm.IssuedByUserName</span></div>
            </div>

            <table class="details-table">
                <thead>
                    <tr>
                        <th width="5%">#</th>
                        <th width="40%">البيان</th>
                        @if (isVoucher)
                        {
                            <th width="35%">بيانات الإيداع</th>
}
                        <th width="20%">المبلغ</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var item in vm.Details)
                    {
                        <tr>
                            <td class="text-center">@(i++)</td>
                            <td>@item.FeeTypeName</td>
                            @if (isVoucher)
                            {
                                <td style="font-size: 10px;">
                                    <strong>@item.BankName</strong><br />
                                    @if (!string.IsNullOrEmpty(item.AccountNumber))
                                    {<span>حـ/: @item.AccountNumber</span>}
                                </td>
                            }
                            <td class="text-center fw-bold">@item.Amount.ToString("N2") @item.CurrencySymbol</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total-row">
                        <td colspan="@(isVoucher ? 3 : 2)" class="text-end pe-3">الإجمالي:</td>
                        <td class="text-center">@vm.TotalAmount.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>

            <div class="amount-words">مبلغ وقدره: @amountText فقط لا غير.</div>

            <div class="footer-signatures">
                <div class="sig-box"><div class="sig-title">توقيع الزميل</div></div>
                <div class="sig-box"><div class="sig-title">الختم الرسمي</div></div>
                <div class="sig-box"><div class="sig-title">الموظف المسؤول</div></div>
            </div>
        </div>
    }
</body>
</html>