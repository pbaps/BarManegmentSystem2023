@model IEnumerable<BarManegment.Models.PracticingLawyerRenewal>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="bg-light text-secondary small text-uppercase">
            <tr>
                <th class="ps-3 border-0">سنة التجديد</th>
                <th class="border-0">التاريخ</th>
                <th class="border-0">الحالة</th>
                <th class="text-center border-0">طباعة</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var renewal in Model)
                {
                    bool isPaid = renewal.ReceiptId.HasValue;
                    bool hasVoucher = renewal.PaymentVoucherId.HasValue;

                    <tr>
                        <td class="ps-3"><span class="badge bg-primary bg-opacity-10 text-primary">@renewal.RenewalYear</span></td>
                        <td>
                            @if (isPaid && renewal.Receipt != null)
                            {
                                <span class="text-success small fw-bold"><i class="bi bi-check2-all"></i> @string.Format("{0:yyyy-MM-dd}", renewal.Receipt.BankPaymentDate)</span>
                            }
                            else
                            {
                                <span class="text-muted small"><i class="bi bi-clock"></i> @string.Format("{0:yyyy-MM-dd}", renewal.RenewalDate)</span>
                            }
                        </td>
                        <td>
                            @if (isPaid)
                            {<span class="badge bg-success">تم السداد</span> }
                            else if (hasVoucher)
                            { <span class="badge bg-warning text-dark">بانتظار الدفع</span> }
                            else
                            { <span class="badge bg-secondary">غير مكتمل</span>}
                        </td>
                        <td class="text-center">
                            @if (isPaid)
                            {
                                <a href="@Url.Action("PrintVoucher", "Dashboard", new { area = "Members", id = renewal.ReceiptId })" target="_blank" class="btn btn-sm btn-outline-success shadow-sm"><i class="bi bi-printer-fill"></i> سند قبض</a>
                            }
                            else if (hasVoucher)
                            {
                                <a href="@Url.Action("PrintVoucher", "Dashboard", new { area = "Members", id = renewal.PaymentVoucherId })" target="_blank" class="btn btn-sm btn-primary shadow-sm"><i class="bi bi-file-earmark-pdf"></i> قسيمة</a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center py-4 text-muted">لا توجد سجلات.</td></tr>
            }
        </tbody>
    </table>
</div>